---
export interface QA { q: string; a: string }
interface Props { items: QA[]; heading?: string }
const { items, heading = 'Frequently asked questions' } = Astro.props;
---
<section class="section" aria-labelledby="faq-h">
  <div class="wrap">
    <div class="head"><h2 id="faq-h">{heading}</h2></div>
    <div class="faq">
      {items.map((it) => <details class="reveal"><summary>{it.q}</summary><div class="a"><p>{it.a}</p></div></details>)}
    </div>
  </div>
</section>
