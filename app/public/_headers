# Cabeceras de seguridad para Cloudflare Pages (M1, revisión de seguridad del hito 8). Expo copia public/ a dist/,
# así que salen en app.cidclean.com y en el portal (quote.cidclean.com, export con EXPO_PUBLIC_PORTAL_ONLY=1).
# connect-src: la API de Supabase y sus websockets (Realtime). frame-src: el visor abre en un iframe los PDF con URL
# firmada de Storage y los W-9 de la Edge Function w9-file. style-src 'unsafe-inline': react-native-web pone sus
# estilos en línea. Fuentes: van dentro del export (expo-font).
/*
  Content-Security-Policy: default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob: https://noammaqhtdfgbheeiugo.supabase.co; font-src 'self' data:; connect-src 'self' https://noammaqhtdfgbheeiugo.supabase.co wss://noammaqhtdfgbheeiugo.supabase.co; frame-src 'self' blob: https://noammaqhtdfgbheeiugo.supabase.co; media-src 'self' blob:; worker-src 'self' blob:; manifest-src 'self'; object-src 'none'; base-uri 'self'; form-action 'self'; frame-ancestors 'none'
  X-Frame-Options: DENY
  Strict-Transport-Security: max-age=31536000; includeSubDomains
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  Permissions-Policy: camera=(self), microphone=(), geolocation=(self), payment=()
